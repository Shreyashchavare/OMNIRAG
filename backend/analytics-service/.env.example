# Analytics Service — local development placeholders only.
# Copy this file to .env (which is git-ignored) and fill in your actual values locally.
# NEVER put real credentials, passwords, tokens, or private keys in this file.

ANALYTICS_SERVER_PORT=8080

# PostgreSQL — analytics_db (separate from identity_db, knowledge_db, etc.)
# Inside Docker Compose, use the Docker DNS name (postgres), not localhost.
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5432/analytics_db
ANALYTICS_DB_USERNAME=replace-with-local-analytics-db-user
ANALYTICS_DB_PASSWORD=replace-with-local-password

# RSA public key for JWT validation (Identity Service public key)
# Path must be accessible by the running application.
# Use classpath:certs/public_key.pem (place Identity's public_key.pem in src/main/resources/certs/)
# or use file:/absolute/path/to/public_key.pem
ANALYTICS_JWT_PUBLIC_KEY_PATH=classpath:certs/public_key.pem
ANALYTICS_JWT_ISSUER=http://localhost:8080

# Optional upstream base URLs (used when real integrations are implemented)
IDENTITY_SERVICE_BASE_URL=http://localhost:8081
KNOWLEDGE_SERVICE_BASE_URL=http://localhost:8082
PROCESSING_SERVICE_BASE_URL=http://localhost:8083
RAG_SERVICE_BASE_URL=http://localhost:8002

# Connection / read timeouts for upstream calls (milliseconds)
ANALYTICS_UPSTREAM_CONNECT_TIMEOUT_MS=2000
ANALYTICS_UPSTREAM_READ_TIMEOUT_MS=5000
