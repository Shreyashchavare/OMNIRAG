# =============================================================================
# Knowledge Service — Local Environment Template
# =============================================================================
# Copy this file to '.env' for local development.
# NEVER commit the actual '.env' file or any real secrets to Git.
# =============================================================================

SERVER_PORT=8082

# Database connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowledge_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-local-knowledge-db-password

# Optional granular host/port variables for local environment scripts
KNOWLEDGE_DB_HOST=localhost
KNOWLEDGE_DB_PORT=5432
KNOWLEDGE_DB_NAME=knowledge_db
KNOWLEDGE_DB_USERNAME=postgres
KNOWLEDGE_DB_PASSWORD=replace-with-local-knowledge-db-password
