# OMRAGUL Gateway Service - Local Development Template
# Copy required settings to the root .env file.
# Never put real credentials, tokens, or private keys in this template.

# Gateway server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# Backend service URLs (Docker Compose internal URLs)
IDENTITY_SERVICE_URL=http://identity-service:8080
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8080
PROCESSING_SERVICE_URL=http://processing-service:8080
ANALYTICS_SERVICE_URL=http://analytics-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080

# Frontend CORS origin
FRONTEND_ORIGIN=http://localhost:3000

# Gateway HTTP timeouts (milliseconds)
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_READ_TIMEOUT_MS=30000

# JWT configuration (public key verification only; no private key)
GATEWAY_JWT_PUBLIC_KEY_PATH=classpath:certs/public_key.pem
GATEWAY_JWT_ISSUER=http://localhost:8080