# OMRAGUL — Local Development Environment Template
# Copy this file to `.env` and configure values for your machine.
# Never commit `.env`. All credentials below are placeholders.
#
# IMPORTANT:
# Keep variable names aligned with docker-compose*.yml and each service's
# application configuration. Variables not referenced by Compose/application
# config will not take effect merely because they appear here.
#
# No internal_api_key / INTERNAL_API_KEY is defined intentionally.

# ---------------------------------------------------------------------------
# Docker / Spring profiles
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker

# ---------------------------------------------------------------------------
# Host ports
# Verify these against the active docker-compose file.
# Compose must reference ${VARIABLE:-default} for overrides to work.
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
GATEWAY_PORT=8080
IDENTITY_PORT=8081
KNOWLEDGE_PORT=8082
PROCESSING_PORT=8083
ANALYTICS_PORT=8084
NOTIFICATION_PORT=8085

EMBEDDING_PORT=8001
MULTIMODAL_PORT=8002
RAG_PORT=8003
AGENT_PORT=8004

POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# PostgreSQL — local development only
# Replace placeholders in your actual .env with your chosen local values.
# Verify database names and credentials against Docker Compose.
# ---------------------------------------------------------------------------
POSTGRES_DB=omragul
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD

# Optional shared connection defaults.
# Use only if the service configuration references these variable names.
# Inside Docker, use the Compose service hostname (e.g. postgres).
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/omragul
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD

# ---------------------------------------------------------------------------
# Processing service
# Confirm the application configuration uses these exact variable names.
# ---------------------------------------------------------------------------
PROCESSING_DB_NAME=processing_db
PROCESSING_DB_URL=jdbc:postgresql://postgres:5432/processing_db
PROCESSING_DB_USERNAME=postgres
PROCESSING_DB_PASSWORD=CHANGE_ME_PROCESSING_DB_PASSWORD

# ---------------------------------------------------------------------------
# pgAdmin — development only
# ---------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ---------------------------------------------------------------------------
# Redis — inside Docker use redis:6379
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# AI services — verify service names and ports against Compose.
# Inside Docker, use Compose service hostnames.
# ---------------------------------------------------------------------------
EMBEDDING_SERVICE_URL=http://embedding-service:8003
MULTIMODAL_SERVICE_URL=http://multimodal-service:8004
RAG_SERVICE_URL=http://rag-service:8002
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8080

# Host-based development alternatives (uncomment/use when running services
# outside Docker; adjust ports to match their actual host bindings):
# EMBEDDING_SERVICE_URL=http://localhost:8003
# MULTIMODAL_SERVICE_URL=http://localhost:8004
# RAG_SERVICE_URL=http://localhost:8002
# AGENT_SERVICE_URL=http://localhost:8000
# KNOWLEDGE_SERVICE_URL=http://localhost:8082

# ---------------------------------------------------------------------------
# Ollama — inside Docker use ollama:11434
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
