# Notification Service local configuration template
# Copy to .env for local development; never commit .env.
# Align these names with the actual application.yml and Compose configuration.

NOTIFICATION_SERVER_PORT=8085

# PostgreSQL (adjust hostname for Docker networking)
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USERNAME=db_name
NOTIFICATION_DB_PASSWORD=CHANGE_ME

# JWT verification values only if required by existing OMRAGUL Identity conventions.
# Use the configured public key/certificate path; never place private keys or tokens here.
NOTIFICATION_JWT_PUBLIC_KEY_PATH=classpath:certs/public_key.pem
NOTIFICATION_JWT_ISSUER=http://localhost:8080

# Internal service-to-service notification ingestion is deferred until authentication
# is agreed. Do not add an internal API key or shared static secret.
