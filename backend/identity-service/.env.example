# =============================================================================
# Identity Service — Local Environment Template
# =============================================================================
# Copy this file to '.env' for standalone local development (outside Docker).
# NEVER commit the actual '.env' file or any real secrets to Git.
#
# Note: When running inside Docker via docker-compose, the service defaults
# to internal container port 8080 (mapped to host port ${IDENTITY_PORT:-8081}),
# matching Gateway's downstream routing URL (http://identity-service:8080).
# =============================================================================

SERVER_PORT=8081

# Database Configuration
IDENTITY_DATASOURCE_URL=jdbc:postgresql://localhost:5432/identity_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/identity_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-local-identity-db-password
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-identity-db-password

# JWT Configuration
# Private key: path must point to local private_key.pem (not committed to git)
# Public key: path to public_key.pem
IDENTITY_JWT_PRIVATE_KEY_PATH=classpath:certs/private_key.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=classpath:certs/public_key.pem
IDENTITY_JWT_EXPIRATION_MINUTES=15
IDENTITY_JWT_ISSUER=http://localhost:8080

# Refresh Token & OTP Policy
IDENTITY_REFRESH_TOKEN_EXPIRATION_DAYS=30
IDENTITY_OTP_EXPIRATION_MINUTES=5
IDENTITY_MAX_FAILED_LOGIN_ATTEMPTS=5