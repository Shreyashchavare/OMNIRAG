# =============================================================================
# Identity Service — Local Environment Template
# =============================================================================
# Copy this file to '.env' for local development.
# NEVER commit the actual '.env' file or any real secrets to Git.
# =============================================================================

SERVER_PORT=8081

# Database configuration
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-identity-db-password

# JWT configuration
# Private key: path must point to local private_key.pem (not committed to git)
# Public key: path to public_key.pem
IDENTITY_JWT_PRIVATE_KEY_PATH=classpath:certs/private_key.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=classpath:certs/public_key.pem
IDENTITY_JWT_EXPIRATION_MINUTES=15
IDENTITY_JWT_ISSUER=http://localhost:8080

# Refresh token & OTP
IDENTITY_REFRESH_TOKEN_EXPIRATION_DAYS=30
IDENTITY_OTP_EXPIRATION_MINUTES=5
IDENTITY_MAX_FAILED_LOGIN_ATTEMPTS=5
