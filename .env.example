# OMRAGUL development environment template
# Copy to .env locally. Never commit .env or put real secrets in this file.

FRONTEND_PORT=3000
GATEWAY_PORT=8080
IDENTITY_PORT=8081
KNOWLEDGE_PORT=8082
PROCESSING_PORT=8083
ANALYTICS_PORT=8084
NOTIFICATION_PORT=8085

EMBEDDING_PORT=8001
RAG_PORT=8002
MULTIMODAL_PORT=8003
AGENT_PORT=8004

# AI Models and Service Configurations
EMBEDDING_MODEL=bge-m3
RAG_OLLAMA_MODEL=qwen3:4b
EMBEDDING_DIMENSION=1024
MULTIMODAL_OLLAMA_MODEL=qwen3-vl:4b
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AGENT_OLLAMA_MODEL=qwen3-vl:4b

POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

OLLAMA_PORT=11434
NGINX_PORT=8088
# Set only when enabling the optional nginx edge profile and the file exists:
# NGINX_CONFIG_PATH=./infrastructure/nginx/nginx.conf

SPRING_PROFILES_ACTIVE=docker

IDENTITY_DATASOURCE_URL=jdbc:postgresql://postgres:5432/identity_db
KNOWLEDGE_DATASOURCE_URL=jdbc:postgresql://postgres:5432/knowledge_db
PROCESSING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/processing_db
ANALYTICS_DATASOURCE_URL=jdbc:postgresql://postgres:5432/analytics_db
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://postgres:5432/notification_db
