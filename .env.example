# ==============================================================================
# OMRAGUL — Enterprise Knowledge Management & Multimodal RAG Platform
# Centralized Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root for local development.
# NEVER commit `.env` or place real production secrets in this file.
# All secret values below are non-functional placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
SPRING_PROFILES_ACTIVE=docker

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 17 & pgAdmin)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

# Shared Spring datasource connection aliases (standalone local run)
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
SPRING_FLYWAY_ENABLED=true

# Per-microservice database connection strings (Docker network defaults)
IDENTITY_DATASOURCE_URL=jdbc:postgresql://postgres:5432/identity_db
KNOWLEDGE_DATASOURCE_URL=jdbc:postgresql://postgres:5432/knowledge_db
PROCESSING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/processing_db
ANALYTICS_DATASOURCE_URL=jdbc:postgresql://postgres:5432/analytics_db
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://postgres:5432/notification_db

# Standalone Microservice Direct Database Overrides (for standalone host execution outside Docker)
KNOWLEDGE_DB_URL=jdbc:postgresql://localhost:5432/knowledge_db
KNOWLEDGE_DB_USERNAME=postgres
KNOWLEDGE_DB_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
PROCESSING_DB_URL=jdbc:postgresql://localhost:5432/processing_db
PROCESSING_DB_USERNAME=postgres
PROCESSING_DB_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5432/analytics_db
ANALYTICS_DB_USERNAME=postgres
ANALYTICS_DB_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

# pgAdmin (management tools profile)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Redis 8 Alpine)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

# ------------------------------------------------------------------------------
# 4. INTERNAL SERVICE AUTHENTICATION (Service-to-Service Trust)
# ------------------------------------------------------------------------------
# Mandatory shared secret for internal communication (e.g. Processing -> Knowledge)
# Services validate this secret at startup and abort boot if missing, blank, or default.
INTERNAL_SERVICE_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ------------------------------------------------------------------------------
# 5. JWT & AUTHENTICATION CONFIGURATION (RS256 Asymmetric Tokens)
# ------------------------------------------------------------------------------
# Identity Service signing key provisioning (host mount directory & container path)
IDENTITY_DEV_SECRETS_PATH=./secrets
IDENTITY_JWT_PRIVATE_KEY_PATH=file:/secrets/private_key.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=classpath:certs/dev_public_key.pem
IDENTITY_JWT_EXPIRATION_MINUTES=15
IDENTITY_JWT_ISSUER=http://localhost:8080
IDENTITY_REFRESH_TOKEN_EXPIRATION_DAYS=30
IDENTITY_OTP_EXPIRATION_MINUTES=5
IDENTITY_MAX_FAILED_LOGIN_ATTEMPTS=5

# Downstream service public key paths for token verification
GATEWAY_JWT_PUBLIC_KEY_PATH=classpath:certs/dev_public_key.pem
GATEWAY_JWT_ISSUER=http://localhost:8080
ANALYTICS_JWT_PUBLIC_KEY_PATH=classpath:certs/dev_public_key.pem
ANALYTICS_JWT_ISSUER=http://localhost:8080
NOTIFICATION_JWT_PUBLIC_KEY_PATH=classpath:certs/dev_public_key.pem
NOTIFICATION_JWT_ISSUER=http://localhost:8080

# ------------------------------------------------------------------------------
# 6. BACKEND SERVICE URLS AND PORTS
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
IDENTITY_PORT=8081
KNOWLEDGE_PORT=8082
PROCESSING_PORT=8083
ANALYTICS_PORT=8084
NOTIFICATION_PORT=8085
# Default internal server port for Java microservices (inside container / standalone)
SERVER_PORT=8080
PORT=8080
PROCESSING_SERVER_PORT=8080
ANALYTICS_SERVER_PORT=8080
NOTIFICATION_SERVER_PORT=8080

# Gateway reverse proxy upstream targets (Docker network DNS names)
IDENTITY_SERVICE_URL=http://identity-service:8080
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8080
PROCESSING_SERVICE_URL=http://processing-service:8080
ANALYTICS_SERVICE_URL=http://analytics-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
EMBEDDING_SERVICE_URL=http://embedding-service:8000
RAG_SERVICE_URL=http://rag-service:8000
MULTIMODAL_SERVICE_URL=http://multimodal-service:8000
AGENT_SERVICE_URL=http://agent-service:8000

# Edge Reverse Proxy (optional --profile edge)
NGINX_PORT=8088
NGINX_CONFIG_PATH=./infrastructure/nginx/nginx.conf

# ------------------------------------------------------------------------------
# 7. AI / LLM / MULTIMODAL CONFIGURATION (Local Offline Services)
# ------------------------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen3-vl:4b

EMBEDDING_PORT=8001
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

RAG_PORT=8002
RAG_OLLAMA_MODEL=qwen3:4b

MULTIMODAL_PORT=8003
MULTIMODAL_OLLAMA_MODEL=qwen3-vl:4b
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

AGENT_PORT=8004
AGENT_OLLAMA_MODEL=qwen3-vl:4b

# ------------------------------------------------------------------------------
# 8. EXTERNAL API CREDENTIALS (Optional External Fallbacks - Offline by Default)
# ------------------------------------------------------------------------------
# OMRAGUL operates in offline-first air-gapped mode using local Ollama and Whisper.
# External API keys must remain empty unless specifically configuring cloud fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# 9. FRONTEND CONFIGURATION (Vite React Client)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
# Only VITE_* variables are exposed to the client browser bundle.
# NEVER place private keys or backend service secrets into VITE_* variables.
VITE_API_GATEWAY_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY, LOGGING & TIMEOUTS
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
GATEWAY_CONNECT_TIMEOUT_MS=1000
GATEWAY_READ_TIMEOUT_MS=5000
PROCESSING_CONNECT_TIMEOUT_MS=1000
PROCESSING_READ_TIMEOUT_MS=5000
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_EXECUTOR_CORE_POOL_SIZE=4
PROCESSING_EXECUTOR_MAX_POOL_SIZE=8
PROCESSING_EXECUTOR_QUEUE_CAPACITY=100
ANALYTICS_UPSTREAM_CONNECT_TIMEOUT_MS=1000
ANALYTICS_UPSTREAM_READ_TIMEOUT_MS=5000