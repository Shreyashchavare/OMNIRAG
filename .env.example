# =============================================================================
# OMRAGUL — Root Environment Configuration Template
# =============================================================================
# Copy this file to '.env' for local development.
# NEVER commit the actual '.env' file or any real secrets to Git.
#
# All values provided here are safe non-sensitive defaults or placeholders.
# =============================================================================

# Application environment
ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Host Ports
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
GATEWAY_PORT=8080
IDENTITY_PORT=8081
KNOWLEDGE_PORT=8082
PROCESSING_PORT=8083
ANALYTICS_PORT=8084
NOTIFICATION_PORT=8085

EMBEDDING_PORT=8001
MULTIMODAL_PORT=8002
RAG_PORT=8003
AGENT_PORT=8004

POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050
OLLAMA_PORT=11434

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration (Local Development)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password

# -----------------------------------------------------------------------------
# Service Database Names
# -----------------------------------------------------------------------------
IDENTITY_DB_NAME=identity_db
KNOWLEDGE_DB_NAME=knowledge_db
PROCESSING_DB_NAME=processing_db
ANALYTICS_DB_NAME=analytics_db
NOTIFICATION_DB_NAME=notification_db

# -----------------------------------------------------------------------------
# AI Services & Ollama
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_MODEL=qwen3:4b
