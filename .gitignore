############################
.project
.classpath
.settings/
.springBeans
.sts4-cache/

############################
# Java / Maven / Spring Boot
############################
target/
*.class
*.jar
*.war
*.ear

############################
# Gradle (if ever used)
############################
.gradle/
build/

############################
# Logs
############################
logs/
*.log

############################
# Python
############################
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

.venv/
venv/
ENV/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage*
htmlcov/

############################
# Python Packaging
############################
dist/
build/
*.egg-info/
.eggs/
pip-wheel-metadata/

############################
# Jupyter
############################
.ipynb_checkpoints/

############################
# Node / React
############################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

############################
# React Build
############################
frontend/dist/
frontend/build/

############################
